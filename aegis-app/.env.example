# Aegis Frontend Environment Variables
#
# Program addresses default to devnet (from @aegis/sdk DEVNET_CONFIG).
# To use a different deployment (e.g., devnet2), set these two env vars:
# NEXT_PUBLIC_AEGIS_PROGRAM_ID=<program-id>
# NEXT_PUBLIC_ZKBTC_MINT=<mint-address>
# All PDAs (pool state, commitment tree, pool vault) are auto-derived.

# Override Aegis program ID (optional — defaults to devnet)
# NEXT_PUBLIC_AEGIS_PROGRAM_ID=
# Override zkBTC mint address (optional — defaults to devnet)
# NEXT_PUBLIC_ZKBTC_MINT=

# Network identifier
NEXT_PUBLIC_NETWORK=devnet

# Backend API URL
# Default: http://localhost:8080
NEXT_PUBLIC_ZKBTC_API_URL=http://localhost:8080

# Helius API Key (recommended)
# Get your free API key at https://dev.helius.xyz
# Provides better RPC reliability and priority fee estimation
NEXT_PUBLIC_HELIUS_API_KEY=

# Server-side Helius API Key (for API routes - more secure, not exposed to client)
# If not set, falls back to NEXT_PUBLIC_HELIUS_API_KEY
HELIUS_API_KEY=

# Solana RPC Endpoint
# Optional: If HELIUS_API_KEY is set, uses Helius RPC; otherwise falls back to public devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Circuit CDN URL (for ZK proof artifacts)
# Default: /circuits (local public folder)
# Production CDN (Cloudflare R2):
NEXT_PUBLIC_CIRCUIT_CDN_URL=https://circuits.amidoggy.xyz

# Server-side Keypairs (JSON array format)
# Admin keypair - required for demo/mock deposits
# Format: [1,2,3,...,64] (64-byte secret key as JSON array)
# ADMIN_KEYPAIR=

# Relayer keypair - for header relay service
# RELAYER_KEYPAIR=
