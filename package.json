{
  "name": "utxopia",
  "private": true,
  "workspaces": [
    "sdk",
    "web",
    "packages/*",
    "chains/sui/indexer"
  ],
  "scripts": {
    "build:sdk": "cd sdk && bun run build",
    "build:frontend": "cd web && bun run build",
    "build": "bun run build:sdk && bun run build:frontend",
    "dev": "cd web && bun run dev",
    "setup": "./scripts/setup.sh devnet",
    "setup:local": "./scripts/setup.sh localnet",
    "setup:devnet": "./scripts/setup.sh devnet",
    "setup:mainnet": "./scripts/setup.sh mainnet",
    "setup:stop": "./scripts/setup.sh localnet --stop",
    "setup:seed": "./scripts/setup.sh localnet --seed-only",
    "test": "bun run test:sdk && bun run test:web",
    "test:sdk": "bun test sdk/test/",
    "test:sdk-core": "cd packages/sdk-core && bun test test",
    "test:sdk-sui": "cd packages/sdk-sui && bun test test",
    "test:btc-client": "cd packages/btc-client && bun test test",
    "test:sui-indexer": "cd chains/sui/indexer && bun test test",
    "test:sui-contracts": "cd chains/sui/contracts && sui move test",
    "test:sui": "bun run test:sui-contracts && bun run test:sdk-core && bun run test:sdk-sui && bun run test:btc-client && bun run test:sui-indexer",
    "poc:sui-core": "bun run chains/sui/scripts/core-poc.ts",
    "sui:poc:deploy": "bun run chains/sui/scripts/deploy.ts",
    "sui:poc:init": "bun run chains/sui/scripts/init.ts",
    "sui:poc:register-vkey": "bun run chains/sui/scripts/register-vkey.ts",
    "sui:ika:status": "bun run chains/sui/scripts/ika-status.ts",
    "sui:ika:discover": "bun run chains/sui/scripts/ika-discover.ts",
    "sui:ika:import-key": "bun run chains/sui/scripts/ika-import-key.ts",
    "sui:poc:live-core": "bun run chains/sui/scripts/live-core-poc.ts",
    "sui:poc:live-transact": "bun run chains/sui/scripts/live-transact.ts",
    "sui:poc:regtest-flow": "bun run chains/sui/scripts/regtest-flow.ts",
    "sui:poc:all": "bun run chains/sui/scripts/live-all.ts",
    "sui:poc:fresh-all": "bun run chains/sui/scripts/live-all.ts --fresh",
    "export:sui-vkey": "cargo run --manifest-path tools/sui-groth16-exporter/Cargo.toml -- vkey",
    "test:web": "cd web && bun test src/",
    "test:chain": "bun run scripts/e2e/run-all.ts",
    "test:full-stack": "bun run scripts/e2e/full-stack-smoke.ts",
    "test:full-stack:skip-chain": "bun run scripts/e2e/full-stack-smoke.ts --skip-chain",
    "vercel-build": "bun run build:sdk && bun run build:frontend"
  },
  "dependencies": {
    "@ika.xyz/sdk": "^0.4.1",
    "@mysten/sui": "^2.17.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "bech32": "^2.0.0",
    "next": "16.1.1"
  },
  "devDependencies": {
    "@bonfida/spl-name-service": "^3.0.19",
    "@happy-dom/global-registrator": "^20.8.4",
    "@solana/spl-token": "^0.4.14",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.98.4",
    "circomlibjs": "^0.1.7",
    "happy-dom": "^20.8.4",
    "snarkjs": "^0.7.5"
  }
}
