{
  "name": "privacy-coin",
  "private": true,
  "workspaces": [
    "sdk",
    "web"
  ],
  "scripts": {
    "build:sdk": "cd sdk && bun run build",
    "build:frontend": "cd web && bun run build",
    "build": "bun run build:sdk && bun run build:frontend",
    "dev": "cd web && bun run dev",
    "setup": "./scripts/setup.sh devnet",
    "setup:local": "./scripts/setup.sh localnet",
    "setup:devnet": "./scripts/setup.sh devnet",
    "setup:mainnet": "./scripts/setup.sh mainnet",
    "setup:stop": "./scripts/setup.sh localnet --stop",
    "setup:seed": "./scripts/setup.sh localnet --seed-only",
    "test": "bun run test:sdk && bun run test:web",
    "test:sdk": "bun test sdk/test/",
    "test:web": "cd web && bun test src/",
    "test:chain": "bun run scripts/e2e/run-all.ts",
    "test:full-stack": "bun run scripts/e2e/full-stack-smoke.ts",
    "test:full-stack:skip-chain": "bun run scripts/e2e/full-stack-smoke.ts --skip-chain",
    "vercel-build": "bun run build:sdk && bun run build:frontend"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "bech32": "^2.0.0",
    "next": "16.1.1"
  },
  "devDependencies": {
    "@bonfida/spl-name-service": "^3.0.19",
    "@happy-dom/global-registrator": "^20.8.4",
    "@solana/spl-token": "^0.4.14",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.98.4",
    "circomlibjs": "^0.1.7",
    "happy-dom": "^20.8.4",
    "snarkjs": "^0.7.5"
  }
}
