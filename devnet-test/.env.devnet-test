# =============================================================================
# zVault Devnet Integration Test — Environment Configuration
# =============================================================================
# Copy to .env and fill in generated values after bootstrap.sh

# --- Network ---
ZVAULT_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
BITCOIN_NETWORK=testnet
ESPLORA_URL=https://blockstream.info/testnet/api

# --- Program IDs (from contracts/config.json) ---
ZVAULT_PROGRAM_ID=2dBmKyfLibkqdxgyEWUhHos3g56oU2wXLVrucY2dCpGV
BTC_LIGHT_CLIENT_PROGRAM_ID=DeDut4fkjbWBPY4FRUU3q9BUcvwTisHczj1EQmqX5avS

# --- FROST Threshold Signing ---
ZVAULT_SIGNING_MODE=frost
FROST_THRESHOLD=2
FROST_PARTICIPANTS=3
FROST_SIGNER_1_URL=http://localhost:8081
FROST_SIGNER_2_URL=http://localhost:8082
FROST_SIGNER_3_URL=http://localhost:8083
# Populated by bootstrap.sh after DKG:
FROST_GROUP_PUBKEY=

# --- Backend API ---
BACKEND_API_URL=http://localhost:3001
BACKEND_API_PORT=3001

# --- Deposit Tracker ---
DEPOSIT_REQUIRED_CONFIRMATIONS=1
DEPOSIT_POLL_INTERVAL_SECS=10
DEPOSIT_SWEEP_FEE_RATE=2

# --- Redemption ---
ZVAULT_BROADCAST_MODE=real
REDEMPTION_CHECK_INTERVAL_SECS=15
REDEMPTION_MIN_WITHDRAWAL=5000
REDEMPTION_MAX_WITHDRAWAL=10000000
REDEMPTION_REQUIRED_CONFIRMATIONS=1

# --- Header Relayer ---
HEADER_RELAYER_POLL_INTERVAL=30000
HEADER_RELAYER_START_HEIGHT=

# --- Wallet / Payer ---
SOLANA_KEYPAIR_PATH=~/.config/solana/johnny.json

# --- Test Settings ---
TEST_DEPOSIT_AMOUNT_SATS=10000
TEST_TIMEOUT_MS=120000
PROOF_TIMEOUT_MS=300000
