      "boundElements": null,
      "updated": 1772186825179,
      "link": null,
      "locked": false,
      "text": "spendingKey (BJJ): 0x1a2b3c...\nnullifyingKey (BN254): 0x4d5e6f...\nviewingKey (Ed25519): 0x7a8b9c...\nMPK = Poseidon(spendPub.x, .y, nullKey)\nrandom = SHA256(ECDH(eph, viewPub) || \"random\")\nNPK = Poseidon(MPK, random) → 0x0105484d...",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "spendingKey (BJJ): 0x1a2b3c...\nnullifyingKey (BN254): 0x4d5e6f...\nviewingKey (Ed25519): 0x7a8b9c...\nMPK = Poseidon(spendPub.x, .y, nullKey)\nrandom = SHA256(ECDH(eph, viewPub) || \"random\")\nNPK = Poseidon(MPK, random) → 0x0105484d...",
      "autoResize": true,
      "lineHeight": 1.25
