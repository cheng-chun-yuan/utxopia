# UTXOpia Backend Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env files with real secrets to version control.

# ============================================================================
# Server Configuration
# ============================================================================

# API Server Port
PORT=8080

# Logging Level (trace, debug, info, warn, error)
RUST_LOG=info

# ============================================================================
# Network Configuration
# ============================================================================

# Network environment: "mainnet", "testnet", or "devnet"
UTXOPIA_NETWORK=devnet

# Solana RPC endpoint (defaults to network-specific public endpoint)
# UTXOPIA_SOLANA_RPC=https://api.devnet.solana.com

# Bitcoin/Esplora API endpoint (defaults to network-specific mempool.space API)
# UTXOPIA_BITCOIN_RPC=https://mempool.space/testnet4/api

# ============================================================================
# Solana Program Configuration
# ============================================================================

# UTXOpia program ID (deployed contract address)
# Required for mainnet/testnet, optional for devnet (has defaults)
# UTXOPIA_PROGRAM_ID=AtztELZfz3GHA8hFQCv7aT9Mt47Xhknv3ZCNb3fmXsgf

# Pool state PDA address
# UTXOPIA_POOL_STATE=8bbcVecB619HHsHn2TQMraJ8R8WjQjApdZY7h9JCJW7b

# Commitment tree PDA address
# UTXOPIA_COMMITMENT_TREE=HtfDXZ5mBQNBdZrDxJMbXCDkyUqFdTDj7zAqo3aqrqiA

# zkBTC mint address (Token-2022)
# UTXOPIA_ZKBTC_MINT=HiDyAcEBTS7SRiLA49BZ5B6XMBAksgwLEAHpvteR8vbV

# ============================================================================
# Signing Configuration
# ============================================================================

# Signing mode: "single" (development) or "frost" (production)
# For mainnet, FROST is required.
UTXOPIA_SIGNING_MODE=single

# Solana relayer keypair path
# SOLANA_WALLET_PATH=~/.config/solana/id.json

# Sui relayer/operator keypair path. This points to a local Sui keystore;
# keep the key funded with Sui testnet gas if it submits PTBs.
# UTXOPIA_SUI_NETWORK=testnet
# UTXOPIA_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# UTXOPIA_SUI_PACKAGE_ID=
# UTXOPIA_SUI_RELAYER_ADDRESS=
# UTXOPIA_SUI_RELAYER_KEYPAIR_PATH=~/.sui/sui_config/sui.keystore
# UTXOPIA_SUI_RELAYER_KEY_SCHEME=ed25519
# UTXOPIA_SUI_GAS_BUDGET=100000000
# UTXOPIA_SUI_IKA_NETWORK=testnet
# UTXOPIA_SUI_IKA_PACKAGE=
# UTXOPIA_SUI_IKA_SYSTEM_OBJECT_ID=
# UTXOPIA_SUI_IKA_DWALLET_COORDINATOR_ID=
# UTXOPIA_SUI_IKA_DWALLET_ID=
# UTXOPIA_SUI_IKA_DWALLET_CAP_ID=
# UTXOPIA_SUI_IKA_NETWORK_ENCRYPTION_KEY_ID=
# UTXOPIA_SUI_IKA_COIN_ID=
# UTXOPIA_SUI_IKA_SUI_COIN_ID=

# BTC signing key (hex-encoded, 32 bytes)
# Only used in "single" signing mode
# For devnet, a derived key is used if not set
# UTXOPIA_BTC_SIGNER_KEY=your_hex_private_key_here

# ============================================================================
# FROST Configuration (Production Only)
# ============================================================================

# Required number of signers (threshold)
# UTXOPIA_FROST_THRESHOLD=2

# Total number of participants
# UTXOPIA_FROST_PARTICIPANTS=3

# FROST coordinator URL
# FROST_COORDINATOR_URL=http://localhost:9000

# This node's encrypted key share (from DKG ceremony)
# UTXOPIA_FROST_KEY_SHARE=encrypted_key_share_here

# ============================================================================
# Operational Settings
# ============================================================================

# Maximum deposit per transaction (in satoshis)
# Default: 1,000,000,000 (10 BTC) for mainnet
# UTXOPIA_DEPOSIT_LIMIT_SATS=1000000000

# Enable demo mode (devnet/testnet only)
# Relaxes some checks for testing. NEVER enable on mainnet.
UTXOPIA_DEMO_MODE=1

# Logging level for UTXOpia components
UTXOPIA_LOG_LEVEL=info

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection URL
# DATABASE_URL=postgresql://user:pass@localhost/aegis

# Redis URL (for caching and rate limiting)
# REDIS_URL=redis://localhost:6379

# ============================================================================
# Bitcoin RPC (optional, for full node integration)
# ============================================================================

# BTC_RPC_URL=http://localhost:18332
# BTC_RPC_USER=your_rpc_user
# BTC_RPC_PASS=your_rpc_pass
# BTC_NETWORK=testnet

# ============================================================================
# Monitoring & Alerting
# ============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://...@sentry.io/...

# PagerDuty integration key (for alerting)
# PAGERDUTY_KEY=your_pagerduty_key

# Health check endpoint port
# HEALTH_CHECK_PORT=8081
