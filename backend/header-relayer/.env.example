# ─── Deploy Environment Selector ───────────────────────────────────────
# Set DEPLOY_ENV to select which prefixed vars to use.
# All scripts read <PREFIX>_<VAR> first, then fall back to unprefixed <VAR>.
DEPLOY_ENV=devnet

# ─── Devnet (Solana devnet + Bitcoin testnet4) ─────────────────────────
DEVNET_SOLANA_RPC_URL=https://api.devnet.solana.com
DEVNET_PROGRAM_ID=DeDut4fkjbWBPY4FRUU3q9BUcvwTisHczj1EQmqX5avS
DEVNET_RELAYER_KEYPAIR=[50,128,114,...]
DEVNET_BITCOIN_NETWORK=testnet4
DEVNET_START_BLOCK_HEIGHT=75000
DEVNET_POLL_INTERVAL_MS=30000

# ─── Mainnet (Solana mainnet + Bitcoin mainnet) ───────────────────────
# MAINNET_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# MAINNET_PROGRAM_ID=<your-mainnet-program-id>
# MAINNET_RELAYER_KEYPAIR=[...]
# MAINNET_BITCOIN_NETWORK=mainnet
# MAINNET_START_BLOCK_HEIGHT=880000
# MAINNET_POLL_INTERVAL_MS=60000

# ─── Testnet (Solana devnet + Bitcoin testnet3) ───────────────────────
# TESTNET_SOLANA_RPC_URL=https://api.devnet.solana.com
# TESTNET_PROGRAM_ID=DeDut4fkjbWBPY4FRUU3q9BUcvwTisHczj1EQmqX5avS
# TESTNET_RELAYER_KEYPAIR=[...]
# TESTNET_BITCOIN_NETWORK=testnet
# TESTNET_START_BLOCK_HEIGHT=2900000

# ─── Localnet (local validator + Bitcoin regtest) ─────────────────────
# LOCALNET_SOLANA_RPC_URL=http://localhost:8899
# LOCALNET_PROGRAM_ID=DeDut4fkjbWBPY4FRUU3q9BUcvwTisHczj1EQmqX5avS
# LOCALNET_RELAYER_KEYPAIR=[...]
# LOCALNET_BITCOIN_NETWORK=regtest
# LOCALNET_BITCOIN_API_URL=http://localhost:2140
# LOCALNET_START_BLOCK_HEIGHT=1
