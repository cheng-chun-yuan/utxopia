# UTXOpia Frontend Environment Variables
#
# Program addresses default to devnet (from @utxopia/sdk DEVNET_CONFIG).
# To use a different deployment, set these env vars.
# All PDAs (pool state, commitment tree, pool vault) are auto-derived.

# ── Required ──────────────────────────────────────

# Network identifier
NEXT_PUBLIC_NETWORK=devnet

# Backend API URL (server-side + client-side).
# Production (Vercel) uses the Cloudflare-tunnelled backend:
BACKEND_API_URL=https://api.utxopia.com
NEXT_PUBLIC_BACKEND_API_URL=https://api.utxopia.com
# For purely-local dev (Docker backend on host:3010), override both to http://localhost:3010

# Backend API key (must match BACKEND_API_KEY on the backend)
BACKEND_API_KEY=

# ── Program Overrides (optional — defaults to devnet) ──

# NEXT_PUBLIC_UTXOPIA_PROGRAM_ID=
# NEXT_PUBLIC_ZKBTC_MINT=

# ── Token Mint Overrides (optional — for custom deployments) ──

# NEXT_PUBLIC_WSOL_MINT=
# NEXT_PUBLIC_USDC_MINT=
# NEXT_PUBLIC_USDT_MINT=
# NEXT_PUBLIC_JUPUSD_MINT=

# ── Bitcoin Network ──

# Bitcoin network for address validation and explorer links
# Options: testnet4, testnet, mainnet, regtest
NEXT_PUBLIC_BTC_NETWORK=testnet4

# ── Solana RPC ──

# Solana RPC Endpoint (falls back to public devnet if not set)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ── Sui Testnet POC ──

# These are generated by `UTXOPIA_NETWORK=sui-testnet ./scripts/sync-env.sh`.
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# NEXT_PUBLIC_SUI_PACKAGE_ID=
# NEXT_PUBLIC_SUI_POOL_ID=
# NEXT_PUBLIC_SUI_NULLIFIER_REGISTRY_ID=
# NEXT_PUBLIC_SUI_REDEMPTION_QUEUE_ID=
# NEXT_PUBLIC_SUI_VERIFYING_KEY_REGISTRY_ID=
# NEXT_PUBLIC_SUI_RELAYER_ADDRESS=
# NEXT_PUBLIC_SUI_IKA_NETWORK=testnet
# NEXT_PUBLIC_SUI_IKA_PACKAGE=
# NEXT_PUBLIC_SUI_IKA_SYSTEM_OBJECT_ID=
# NEXT_PUBLIC_SUI_IKA_DWALLET_COORDINATOR_ID=

# ── Sui zkLogin ──

# Google Cloud OAuth client ID for a "Web application" client.
# Authorized JavaScript origin for production:
#   https://utxopia.com
# Authorized redirect URI for production:
#   https://utxopia.com/sui
# Add the same localhost origin/redirect URI for local development if needed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ZKLOGIN_REDIRECT_URI=https://utxopia.com/sui

# ── Privy Auth / Embedded Solana Wallets ──

# Enables Privy passkey/email login and Solana embedded wallets for optional
# .utxopia.sol name ownership. If unset, the app falls back to local passkeys
# and external Solana wallet-adapter only.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional Privy app client ID, if configured in the Privy dashboard.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Server-only secret used by /api/sui/zklogin/salt to derive deterministic salts.
# Generate with: openssl rand -hex 32
ZKLOGIN_SALT_SECRET=

# Optional external services. If salt URL is empty, the app uses /api/sui/zklogin/salt.
# NEXT_PUBLIC_ZKLOGIN_SALT_SERVER_URL=
# NEXT_PUBLIC_ZKLOGIN_PROVER_URL=

# Helius API Key (recommended for better RPC reliability)
# Get a free key at https://dev.helius.xyz
NEXT_PUBLIC_HELIUS_API_KEY=
HELIUS_API_KEY=

# ── ZK Circuit Artifacts ──

# Circuit artifacts location.
# Repo ships only *.vkey.json (~112KB). wasm/zkey live in a GitHub Release;
# fetch with `bash scripts/fetch-circuits.sh` then copy to web/public/circuits.
# Path '/circuits' is served by Next.js from web/public/circuits/.
NEXT_PUBLIC_CIRCUIT_CDN_URL=/circuits

# ── Server-side Keypairs (JSON array format: [1,2,3,...,64]) ──

# Admin keypair — required for demo/mock deposits
# ADMIN_KEYPAIR=

# Relayer keypair — for header relay and transaction relay
# RELAYER_KEYPAIR=
