# ─── Deploy Environment Selector ─────────────────────────────────────────────
# Controls which prefixed variables to read across all components.
# Values: devnet, mainnet, localnet
DEPLOY_ENV=devnet

# ─── Devnet (Solana devnet + Bitcoin testnet4) ───────────────────────────────
DEVNET_SOLANA_RPC_URL=https://api.devnet.solana.com
DEVNET_AEGIS_PROGRAM_ID=8fqRet9WB5PECvKfWmzTPSusJgQz1onzxTLfHD75XKim
DEVNET_BTC_LIGHT_CLIENT_PROGRAM_ID=Ho6UTeF8yFnRdCK15tSZtcJozvkDABJZWYxkgGyWAfyq
DEVNET_BITCOIN_NETWORK=testnet4
DEVNET_BITCOIN_API_URL=https://mempool.space/testnet4/api
DEVNET_FROST_NETWORK=testnet
DEVNET_START_BLOCK_HEIGHT=75000
DEVNET_POLL_INTERVAL_MS=30000

# ─── Mainnet ─────────────────────────────────────────────────────────────────
# MAINNET_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# MAINNET_AEGIS_PROGRAM_ID=<deployed-program-id>
# MAINNET_BITCOIN_NETWORK=mainnet
# MAINNET_BITCOIN_API_URL=https://mempool.space/api
# MAINNET_FROST_NETWORK=bitcoin
# MAINNET_START_BLOCK_HEIGHT=880000

# ─── Localnet (local Solana + Bitcoin regtest) ───────────────────────────────
# LOCALNET_SOLANA_RPC_URL=http://localhost:8899
# LOCALNET_BITCOIN_NETWORK=regtest
# LOCALNET_BITCOIN_API_URL=http://localhost:2140
# LOCALNET_FROST_NETWORK=regtest
