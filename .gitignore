# Root-level ignores
.DS_Store
*.log
node_modules/

.wrangler/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files — NEVER commit secrets
.env
.env.local
.env.devnet
.env.localnet
**/.env
**/.env.*
!**/.env.example

# FROST key material (encrypted shares, group keys, DKG state)
frost_server/keys/
frost_server/config/dkg-state-*.json
aegis-app/config/

# Keypair files — NEVER commit
**/*keypair*.json
**/verifier-keypair.json

# Anchor build artifacts (should be in contracts/ but ignore at root too)
# Note: Root target/ should not exist - it's likely an IDE artifact
target/
.anchor/

# IDE artifacts (flycheck, etc.)
**/flycheck*/

# SDK build output
sdk/dist/

# Subdirectories have their own .gitignore files
# See backend/.gitignore, contracts/.gitignore, and frontend/.gitignore
test-ledger/
.vercel

# Circom build artifacts — gitignore everything heavy (ptau, r1cs, wasm, zkey, sym).
# Verification keys are tiny (~600 bytes each) and the on-chain program hashes them
# via init/update_verification_key_hash, so commit those for reproducibility.
# Large artifacts (wasm/zkey) come from scripts/fetch-circuits.sh.
circuits/build/*
!circuits/build/joinsplit_*/
circuits/build/joinsplit_*/*
!circuits/build/joinsplit_*/*.vkey.json
sdk/circuits/

# Unused programs
contracts/programs/chadbuffer/
.gstack/
backend/data/*.db

# FROST localnet keys (generated by scripts/frost-localnet-setup.sh)
.frost-localnet-keys/
.frost-test-keys/

# Superpowers design docs (generated, not tracked)
docs/superpowers/
scripts/.demo-seed.json
