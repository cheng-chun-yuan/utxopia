# Root-level ignores
.DS_Store
*.log
node_modules/

.wrangler/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files (if needed at root)
.env
.env.local

# FROST key material (encrypted shares, group keys, DKG state)
frost_server/keys/
frost_server/config/dkg-state-*.json
aegis-app/config/

# Environment files (generated by sync-env.sh)
backend/.env.devnet
backend/.env.localnet

# Anchor build artifacts (should be in contracts/ but ignore at root too)
# Note: Root target/ should not exist - it's likely an IDE artifact
target/
.anchor/

# IDE artifacts (flycheck, etc.)
**/flycheck*/

# SDK build output
sdk/dist/

# Subdirectories have their own .gitignore files
# See backend/.gitignore, contracts/.gitignore, and frontend/.gitignore
test-ledger/
.vercel
.env*.local

# Circom build artifacts
circuits/build/
sdk/circuits/

# Unused programs
contracts/programs/chadbuffer/
.gstack/
